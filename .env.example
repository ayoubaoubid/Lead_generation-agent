# =============================================================================
# APPLICATION + SUPABASE AUTH — required now
# =============================================================================

# Next.js public variables. Everything prefixed with NEXT_PUBLIC_ is exposed
# to the browser and frozen during the application build. Use only the
# publishable key here, never the service_role or another secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical application origin used to build trusted Auth redirect URLs.
# Keep this identical to the Supabase Auth Site URL for each environment.
APP_URL=http://localhost:3000

# Server-only Supabase secret. Not required for the current user-facing Auth
# flows. Reserve it for trusted administration jobs after RBAC checks exist.
# Never expose this value to browser code or rename it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# SUPABASE CLI / CI — optional, never exposed to the browser
# =============================================================================

# The project reference is visible in the Dashboard URL. The CLI normally
# receives it through `supabase link --project-ref <ref>`.
SUPABASE_PROJECT_REF=

# Prefer interactive `supabase login` and native credential storage locally.
# These two secrets are only useful for non-interactive CI automation. Do not
# fill or deploy them unless a CI workflow explicitly requires them.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# =============================================================================
# TRIGGER.DEV — required when durable background tasks are enabled
# =============================================================================

TRIGGER_SECRET_KEY=

# Optional: only for self-hosted Trigger.dev. Cloud uses its default API URL.
TRIGGER_API_URL=

# Optional: only when targeting a Trigger.dev preview branch.
TRIGGER_PREVIEW_BRANCH=

# =============================================================================
# OBSERVABILITY — optional during local foundation work
# =============================================================================

SENTRY_DSN=

# =============================================================================
# AI — optional until the AI modules are implemented
# =============================================================================

# Planned provider selection. Keep both values server-only.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# =============================================================================
# LEAD DATA PROVIDERS — optional until their adapters are implemented
# =============================================================================

APOLLO_API_KEY=
FIRECRAWL_API_KEY=
ZEROBOUNCE_API_KEY=

# =============================================================================
# APPLICATION EMAILS — optional; not used for Supabase's default Auth SMTP
# =============================================================================

# RESEND_FROM_EMAIL requires a sender/domain verified by Resend. Leave it empty
# while testing Supabase Auth with its default email service and your Gmail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# =============================================================================
# GOOGLE OAUTH / CALENDAR — optional until the integration is implemented
# =============================================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
