# Next.js public variables. Everything prefixed with NEXT_PUBLIC_ is exposed
# to the browser and frozen during the application build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Durable jobs (not required until Trigger.dev is configured).
TRIGGER_SECRET_KEY=

# Observability (optional during local foundation work).
SENTRY_DSN=

# AI and external providers (optional until their modules are implemented).
GROQ_API_KEY=
APOLLO_API_KEY=
FIRECRAWL_API_KEY=
ZEROBOUNCE_API_KEY=
RESEND_API_KEY=

# Google OAuth / Calendar (optional until the integration is implemented).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
