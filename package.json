{
  "name": "lead-generation-sales",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run-web.mjs dev",
    "build": "node scripts/run-web.mjs build",
    "start": "node scripts/run-web.mjs start",
    "lint": "npm run lint --workspace=@lead-generation/web",
    "lint:fix": "npm run lint:fix --workspace=@lead-generation/web",
    "typecheck": "npm run typecheck:web && npm run typecheck:trigger",
    "typecheck:web": "npm run typecheck --workspace=@lead-generation/web",
    "typecheck:trigger": "tsc --project trigger/tsconfig.json --noEmit",
    "test": "npm run test --workspace=@lead-generation/web",
    "test:e2e": "npm run test:e2e --workspace=@lead-generation/web",
    "test:watch": "npm run test:watch --workspace=@lead-generation/web",
    "supabase:start": "supabase start --exclude edge-runtime,imgproxy,logflare,realtime,storage-api,vector",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local supabase/tests/database",
    "db:types": "supabase gen types --local --lang typescript --schema public > apps/web/src/types/database.generated.ts",
    "trigger:dev": "trigger dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.5",
    "supabase": "2.109.1",
    "trigger.dev": "^4.5.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.7",
    "@trigger.dev/sdk": "^4.5.7"
  }
}
